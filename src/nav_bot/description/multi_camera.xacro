<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <!-- ✅ Add robot_name arg -->
    <xacro:arg name="robot_name" default="nav_bot"/>
    <xacro:property name="robot_name" value="$(arg robot_name)"/>

    <joint name="${robot_name}/camera_joint" type="fixed">
        <parent link="${robot_name}/chassis"/>
        <child link="${robot_name}/camera_link"/>
        <origin xyz="0.305 0 0.08" rpy="0 0 0"/>
    </joint>

    <link name="${robot_name}/camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <joint name="${robot_name}/camera_optical_joint" type="fixed">
        <parent link="${robot_name}/camera_link"/>
        <child link="${robot_name}/camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="${robot_name}/camera_link_optical"/>

    <gazebo reference="${robot_name}/camera_link">
        <material>Gazebo/Red</material>
        <sensor type="camera" name="${robot_name}_camera">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <always_on>true</always_on>
            <update_rate>10.0</update_rate>
            <camera>
                <!-- ✅ Fixed typo: camer_info_topic → camera_info_topic -->
                <camera_info_topic>/model/${robot_name}/camera/camera_info</camera_info_topic>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
            </camera>
            <!-- ✅ Namespaced topic -->
            <topic>/model/${robot_name}/camera/image_raw</topic>
            <!-- ✅ Prefixed frame id -->
            <gz_frame_id>${robot_name}/camera_link_optical</gz_frame_id>
        </sensor>
    </gazebo>

</robot>