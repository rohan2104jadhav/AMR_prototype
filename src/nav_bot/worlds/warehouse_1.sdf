<?xml version="1.0" ?>
<!--
  Converted from Gazebo Classic (SDF 1.6) to Ignition Gazebo (SDF 1.9)

  KEY CHANGES:
  ============
  1. SDF version: 1.6 -> 1.9
  2. Added Ignition system plugins (Physics, Sensors, SceneBroadcaster, UserCommands, Actors)
  3. GUI: replaced <camera> block with GzScene3D plugin
  4. Removed deprecated <audio> element
  5. Removed deprecated <meta><layer> elements  
  6. Poses: removed frame=\'\' attribute (deprecated since SDF 1.7)
  7. Booleans: 0/1 -> false/true throughout
  8. Removed <laser_retro> deprecated tags
  9. Actors: simplified to trajectory-only (removed Gazebo Classic skeleton links)
     Ignition Gazebo handles actor rendering natively via the Actors system plugin
  10. cast_shadows, shadows: converted to boolean strings

  USAGE:
  ======
  # Set resource path so model:// URIs resolve:
  export GZ_SIM_RESOURCE_PATH=/path/to/aws_robomaker_models:$GZ_SIM_RESOURCE_PATH
  
  # For Ignition Fortress:
  ign gazebo warehouse_ignition.sdf
  
  # For Gazebo Garden/Harmonic - rename plugins:
  # ignition-gazebo-*-system  ->  gz-sim-*-system
  # ignition::gazebo::systems::  ->  gz::sim::systems::
-->
<sdf version='1.9'>
  <world name='default'>

    <!-- ============================================================ -->
    <!-- Ignition Gazebo System Plugins (required for simulation)      -->
    <!-- ============================================================ -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    
    <!-- World properties -->
    <gravity>0 0 -9.8</gravity>
    <physics name='default_physics' default='true' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <wind/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- GUI - Ignition format -->
