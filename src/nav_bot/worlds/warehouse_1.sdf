    <!-- Lights -->
    <light name='Warehouse_CeilingLight_003' type='point'>
      <pose>0 0 9 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>80</range><constant>0.3</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>true</cast_shadows>
      <direction>0.1 0.1 -1</direction>
    </light>

    <light name='user_point_light_0' type='point'>
      <pose>4.24341 42.2777 1 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
      <direction>0 0 -1</direction>
    </light>

