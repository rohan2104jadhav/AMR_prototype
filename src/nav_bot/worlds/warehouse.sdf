<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <world name='warehouse'>
    
    <!-- IMPORTANT: These plugins are required for Gazebo Sim to function -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    
    <scene>
      <ambient>0.8 0.5 1</ambient>
      <grid>false</grid>
      <sky>
        <clouds>true</clouds>
      </sky>
      <shadows>1</shadows>
    </scene>

    <light name='sunUTC' type='directional'>
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <model name="warehouse">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="warehouse_base">
        <pose>0 0 -0.1 0 0 0</pose>
        <collision name="warehouse_collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>meshes/nxt_racks/NxT_warehouse_colision.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="warehouse_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>meshes/nxt_racks/NxT_warehouse.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>

      <link name='shelf_base'>
         <pose>2.8 14.0 -0.3 0 0 4.71239</pose>
         <collision name='shelf_collision'>
           <geometry>
             <mesh>
               <scale>0.8 1.2 1.2</scale>
               <uri>meshes/nxt_racks/rack.dae</uri>
             </mesh>
           </geometry>
         </collision>
         <visual name='shelf_visual'>
           <geometry>
             <mesh>
               <scale>0.8 1.2 1.2</scale>
               <uri>meshes/nxt_racks/rack.dae</uri>
             </mesh>
           </geometry>
         </visual>
       </link>           
    </model>

    <spherical_coordinates>
       <surface_model>EARTH_WGS84</surface_model>
       <world_frame_orientation>ENU</world_frame_orientation>
       <latitude_deg>37.412173071650805</latitude_deg>
       <longitude_deg>-121.998878727967</longitude_deg>
       <elevation>38</elevation>
    </spherical_coordinates>        
  </world>
</sdf>